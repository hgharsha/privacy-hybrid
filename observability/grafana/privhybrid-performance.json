{
 "title": "Private Assistant: performance",
 "uid": "privhybrid-perf",
 "schemaVersion": 39,
 "version": 3,
 "refresh": "15s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "privhybrid"
 ],
 "links": [
  {
   "title": "All Private Assistant dashboards",
   "type": "dashboards",
   "tags": [
    "privhybrid"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "panels": [
  {
   "id": 1,
   "title": "Services up over time",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "expr": "privhybrid_up",
     "legendFormat": "{{service}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Up",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "Down",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "fillOpacity": 80
     }
    },
    "overrides": []
   },
   "description": "Green when Ollama or web search answered, red when not."
  },
  {
   "id": 2,
   "title": "Average answer time",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(privhybrid_request_ms_sum[$__rate_interval])) / sum by (route) (rate(privhybrid_request_ms_count[$__rate_interval]) > 0) / 1000",
     "legendFormat": "{{route}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Requests per minute",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(privhybrid_requests_total[$__rate_interval])) * 60",
     "legendFormat": "{{route}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Errors and stops over time",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (route,outcome) (increase(privhybrid_requests_total{outcome!=\"ok\"}[$__rate_interval]))",
     "legendFormat": "{{route}} {{outcome}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Total time spent answering (hours, last 24h)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (route) (increase(privhybrid_request_ms_sum[24h])) / 3600000",
     "legendFormat": "{{route}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "unit": "h"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 6,
   "title": "Metrics scrape",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "up{job=\"privhybrid\"}",
     "legendFormat": "assistant",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Up",
         "color": "green"
        },
        "0": {
         "text": "Down",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "description": "Whether Prometheus can reach the assistant."
  }
 ]
}